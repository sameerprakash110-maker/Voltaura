# VOLTAURA configuration. Every value below has a working default --
# copy this to a .env file at the repo root only if you want to change one.

# --- database ----------------------------------------------------------
# SQLite for local development. Swap for a postgresql+psycopg:// URL and
# the rest of the stack works unchanged.
VOLTAURA_DATABASE_URL=sqlite:///./data/voltaura.db

# --- CORS --------------------------------------------------------------
VOLTAURA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- economics (drive every financial figure in the product) -----------
VOLTAURA_ELECTRICITY_TARIFF=8.50
VOLTAURA_WATER_TARIFF_PER_KL=45.00
VOLTAURA_GRID_EMISSION_FACTOR=0.71
VOLTAURA_WATER_EMISSION_FACTOR=0.344

# --- measurement & verification ----------------------------------------
VOLTAURA_VERIFICATION_THRESHOLD_PCT=5.0
VOLTAURA_VERIFICATION_SIGNIFICANCE=0.05
VOLTAURA_BASELINE_WINDOW_DAYS=14
VOLTAURA_POST_WINDOW_DAYS=14
VOLTAURA_MIN_POST_DAYS_FOR_VERIFICATION=7

# --- anomaly detection --------------------------------------------------
VOLTAURA_IFOREST_CONTAMINATION=0.045
VOLTAURA_RESIDUAL_Z_THRESHOLD=2.5
VOLTAURA_MIN_DEVIATION_PCT=12.0

# --- synthetic data -----------------------------------------------------
VOLTAURA_HISTORY_DAYS=90
VOLTAURA_RANDOM_SEED=20240917

# --- optional narrative LLM --------------------------------------------
# STRICTLY OPTIONAL. With no key, VOLTAURA uses deterministic narratives.
VOLTAURA_LLM_API_KEY=
VOLTAURA_LLM_MODEL=claude-sonnet-5

# --- optional investigation reasoning ----------------------------------
# STRICTLY OPTIONAL. With no key, investigation uses deterministic probes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- optional LLM -------------------------------------------------------
# STRICTLY OPTIONAL. With no key, EcoTwin runs the full loop using
# deterministic narratives. With a key, the LLM only rewrites an
# already-computed diagnosis into fluent prose; it never decides a cause,
# a confidence or a number.
ECOTWIN_LLM_API_KEY=
ECOTWIN_LLM_MODEL=claude-sonnet-5
