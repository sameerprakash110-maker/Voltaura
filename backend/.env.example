# VOLTAURA configuration. Every value below has a working default --
# copy this to a .env file at the repo root only if you want to change one.

# --- database ----------------------------------------------------------
# SQLite for local development. Swap for a postgresql+psycopg:// URL and
# the rest of the stack works unchanged.
VOLTAURA_DATABASE_URL=sqlite:///./data/voltaura.db

# --- CORS --------------------------------------------------------------
VOLTAURA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- economics (drive every financial figure in the product) -----------
VOLTAURA_ELECTRICITY_TARIFF=8.50
VOLTAURA_WATER_TARIFF_PER_KL=45.00
VOLTAURA_GRID_EMISSION_FACTOR=0.71
VOLTAURA_WATER_EMISSION_FACTOR=0.344

# --- measurement & verification ----------------------------------------
VOLTAURA_VERIFICATION_THRESHOLD_PCT=5.0
VOLTAURA_VERIFICATION_SIGNIFICANCE=0.05
VOLTAURA_BASELINE_WINDOW_DAYS=14
VOLTAURA_POST_WINDOW_DAYS=14
VOLTAURA_MIN_POST_DAYS_FOR_VERIFICATION=7

# --- anomaly detection --------------------------------------------------
VOLTAURA_IFOREST_CONTAMINATION=0.045
VOLTAURA_RESIDUAL_Z_THRESHOLD=2.5
VOLTAURA_MIN_DEVIATION_PCT=12.0

# --- synthetic data -----------------------------------------------------
VOLTAURA_HISTORY_DAYS=90
VOLTAURA_RANDOM_SEED=20240917

# --- optional narrative LLM --------------------------------------------
# STRICTLY OPTIONAL. With no key, VOLTAURA uses deterministic narratives.
VOLTAURA_LLM_API_KEY=
VOLTAURA_LLM_MODEL=claude-sonnet-5

# --- optional investigation reasoning ----------------------------------
# STRICTLY OPTIONAL. With no key, investigation uses deterministic probes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- authentication (OTP email verification) ----------------------------
# REQUIRED for a stable demo. Without it, sessions are signed with a secret
# generated per process, so everyone is signed out on every backend restart.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
VOLTAURA_AUTH_SECRET_KEY=

# How long a signed-in session lasts before it must be re-verified.
VOLTAURA_AUTH_TOKEN_TTL_HOURS=168

# One-time passcode behaviour.
VOLTAURA_OTP_LENGTH=6
VOLTAURA_OTP_TTL_MINUTES=10
VOLTAURA_OTP_MAX_ATTEMPTS=5
VOLTAURA_OTP_MAX_REQUESTS_PER_WINDOW=5
VOLTAURA_OTP_REQUEST_WINDOW_MINUTES=15

# Restrict who may sign in, e.g. "ritindia.edu". Empty means any address.
VOLTAURA_AUTH_ALLOWED_EMAIL_DOMAINS=

# --- email delivery (SMTP) ----------------------------------------------
# With SMTP_HOST empty the OTP is written to the server log instead of being
# emailed, so the flow still works offline. Fill these in to send real email.
#
# Gmail: enable 2-Step Verification, then create a 16-character App Password
# at https://myaccount.google.com/apppasswords and use it below (not your
# normal password). Host smtp.gmail.com, port 587.
VOLTAURA_SMTP_HOST=
VOLTAURA_SMTP_PORT=587
VOLTAURA_SMTP_USER=
VOLTAURA_SMTP_PASSWORD=
VOLTAURA_SMTP_FROM=VOLTAURA <no-reply@voltaura.local>
VOLTAURA_SMTP_STARTTLS=true
