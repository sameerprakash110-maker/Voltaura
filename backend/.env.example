# EcoTwin configuration. Every value below has a working default --
# copy this to a .env file at the repo root only if you want to change one.

# --- database ----------------------------------------------------------
# SQLite for local development. Swap for a postgresql+psycopg:// URL and
# the rest of the stack works unchanged.
ECOTWIN_DATABASE_URL=sqlite:///./data/ecotwin.db

# --- CORS --------------------------------------------------------------
ECOTWIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- economics (drive every financial figure in the product) -----------
ECOTWIN_ELECTRICITY_TARIFF=8.50
ECOTWIN_WATER_TARIFF_PER_KL=45.00
ECOTWIN_GRID_EMISSION_FACTOR=0.71
ECOTWIN_WATER_EMISSION_FACTOR=0.344

# --- measurement & verification ----------------------------------------
ECOTWIN_VERIFICATION_THRESHOLD_PCT=5.0
ECOTWIN_VERIFICATION_SIGNIFICANCE=0.05
ECOTWIN_BASELINE_WINDOW_DAYS=14
ECOTWIN_POST_WINDOW_DAYS=14
ECOTWIN_MIN_POST_DAYS_FOR_VERIFICATION=7

# --- anomaly detection --------------------------------------------------
ECOTWIN_IFOREST_CONTAMINATION=0.045
ECOTWIN_RESIDUAL_Z_THRESHOLD=2.5
ECOTWIN_MIN_DEVIATION_PCT=12.0

# --- synthetic data -----------------------------------------------------
ECOTWIN_HISTORY_DAYS=90
ECOTWIN_RANDOM_SEED=20240917

# --- optional narrative LLM --------------------------------------------
# STRICTLY OPTIONAL. With no key, EcoTwin uses deterministic narratives.
ECOTWIN_LLM_API_KEY=
ECOTWIN_LLM_MODEL=claude-sonnet-5

# --- optional investigation reasoning ----------------------------------
# STRICTLY OPTIONAL. With no key, investigation uses deterministic probes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
